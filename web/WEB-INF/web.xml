<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <context-param>
        <param-name>compilerSourceVM</param-name>
        <param-value>1.8</param-value>
    </context-param>
    <context-param>
        <param-name>compilerTargetVM</param-name>
        <param-value>1.8</param-value>
    </context-param>
    <context-param>
        <param-name>companyName</param-name>
        <param-value>HarveyHerman</param-value>
    </context-param>
    <context-param>
        <param-name>companyEmail</param-name>
        <param-value>info@harveyherman.my</param-value>
    </context-param>
    <context-param>
        <param-name>companyCopyright</param-name>
        <param-value>Copyright © 2024 HarveyHerman. All rights reserved.</param-value>
    </context-param>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>user/index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
